# zainVPN coordinator settings, read by deploy.sh (docker run --env-file .env).
#
# deploy.sh creates .env with a random admin password on its first run, so you
# normally don't need this file. To choose values yourself, copy it to .env
# before running deploy.sh. Format: KEY=value, one per line, no quotes (Docker
# passes quotes through literally). Re-run "bash deploy.sh" after a change.

# Address for clients, used for both the TCP control channel and the UDP relay.
# Open TCP *and* UDP on this port to 0.0.0.0/0 in the AWS security group.
ZAINVPN_LISTEN=:29814

# Admin dashboard address. "off" (or an empty value) disables the dashboard.
# Open this port in the security group to your own IP only.
ZAINVPN_HTTP=:21958

# Dashboard password. Required for the dashboard: without it only /healthz is
# served (the VPN itself keeps working). Use a long random value.
ZAINVPN_ADMIN_PASSWORD=change-me-to-something-long-and-random

# Where networks and device IPs are kept. The Docker image already defaults to
# /data/state.json on the zainvpn-data volume; only change it outside Docker.
# ZAINVPN_STATE=/data/state.json
