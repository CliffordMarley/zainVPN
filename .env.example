# zainVPN coordinator settings, read by deploy.sh (docker run --env-file .env).
#
# deploy.sh creates .env with a random admin password on its first run, so you
# normally don't need this file. To choose values yourself, copy it to .env
# before running deploy.sh. Format: KEY=value, one per line, no quotes (Docker
# passes quotes through literally). Re-run "bash deploy.sh" after a change.

# Address for clients, used for both the TCP control channel and the UDP relay.
# Open TCP *and* UDP on this port to 0.0.0.0/0 in the AWS security group.
ZAINVPN_LISTEN=:29814

# Dashboard address. "off" (or an empty value) disables the dashboard. Friends
# download the installer from its sign-in page, so open this port to 0.0.0.0/0
# in the security group (admin pages still need the password below).
ZAINVPN_HTTP=:21958

# Optional extra protection: a code friends must enter on the sign-in page to
# download the installer. The installer holds no secrets (networks are joined
# with invite codes), so this is usually left empty.
# ZAINVPN_DOWNLOAD_CODE=

# Serve this installer instead of the unsigned one deploy.sh builds, e.g. the
# signed build from GitHub Releases (see .github/workflows/release.yml):
# ZAINVPN_INSTALLER_URL=https://github.com/CliffordMarley/zainVPN/releases/latest/download/zainVPN-Setup.exe

# Coordinator address built into the Windows installer that deploy.sh builds.
# Defaults to this instance's public IP; set it if you use a DNS name or an
# Elastic IP that the instance metadata doesn't report.
# ZAINVPN_PUBLIC_ADDR=vpn.example.com

# Dashboard password. Required for the dashboard: without it only /healthz is
# served (the VPN itself keeps working). Use a long random value.
ZAINVPN_ADMIN_PASSWORD=change-me-to-something-long-and-random

# Where networks and device IPs are kept. The Docker image already defaults to
# /data/state.json on the zainvpn-data volume; only change it outside Docker.
# ZAINVPN_STATE=/data/state.json
