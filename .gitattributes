# Normalize line endings in the repository; check out files the coordinator's
# Linux host runs with LF even on Windows (core.autocrlf=true).
* text=auto

*.sh          text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
.env.example  text eol=lf
*.go          text eol=lf
go.mod        text eol=lf
go.sum        text eol=lf

# Windows-only build files.
*.ps1 text eol=crlf
*.iss text eol=crlf

*.dll binary
*.exe binary
*.ico binary
